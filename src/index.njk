<script>
(function () {
  const statusElement = document.getElementById('clubOpenStatus');
  if (!statusElement) return;

  // Opening hours are taken from the existing contact.json file.
  const clubHours = {{ contact.hours | dump | safe }};

  const dayNames = [
    'Sunday', 'Monday', 'Tuesday', 'Wednesday',
    'Thursday', 'Friday', 'Saturday'
  ];

  function getUKTime() {
    const parts = new Intl.DateTimeFormat('en-GB', {
      timeZone: 'Europe/London',
      weekday: 'long',
      hour: '2-digit',
      minute: '2-digit',
      hourCycle: 'h23'
    }).formatToParts(new Date());

    const values = {};
    parts.forEach(function (part) {
      values[part.type] = part.value;
    });

    return {
      day: dayNames.indexOf(values.weekday),
      minutes: Number(values.hour) * 60 + Number(values.minute)
    };
  }

  function getHours(day) {
    return clubHours.find(function (entry) {
      return entry.days === dayNames[day] ||
        (entry.days === 'Monday–Thursday' && day >= 1 && day <= 4);
    });
  }

  function parseTime(value) {
    const match = value && value.match(/^(\d{2}):(\d{2})$/);
    return match ? Number(match[1]) * 60 + Number(match[2]) : null;
  }

  function formatTime(minutes) {
    const hour = Math.floor(minutes / 60) % 24;
    const minute = minutes % 60;
    const period = hour >= 12 ? 'pm' : 'am';

    return (hour % 12 || 12) +
      (minute ? ':' + String(minute).padStart(2, '0') : '') +
      period;
  }
  function setStatusColour(colour) {
    const chip = statusElement.closest('.status-chip');
    if (!chip) return;

    chip.style.backgroundColor =
      colour === 'green' ? '#D5EBDD' :
      colour === 'red' ? '#F5D5D5' :
      '#E8C46A';

    chip.style.color =
      colour === 'green' ? '#155724' :
      colour === 'red' ? '#842029' :
      '#302400';

    const dot = chip.querySelector('.status-dot');
    if (dot) {
      dot.style.backgroundColor =
        colour === 'green' ? '#238636' :
        colour === 'red' ? '#C62828' :
        '#A66300';
    }
  }
   function updateOpeningStatus() {
    const now = getUKTime();
    const today = getHours(now.day);
    const yesterday = getHours((now.day + 6) % 7);

    if (!today) {
      statusElement.textContent = 'See opening hours below';
      setStatusColour('red');
      return;
    }

    // Check whether yesterday's hours extend past midnight.
    if (yesterday) {
      const previousTimes = yesterday.time.split('–');
      const previousOpen = parseTime(previousTimes[0]);
      const previousClose = parseTime(previousTimes[1]);

      if (previousOpen !== null &&
          previousClose !== null &&
          previousClose < previousOpen &&
          now.minutes < previousClose) {
        statusElement.textContent =
          'Scheduled open until ' + formatTime(previousClose);
        setStatusColour('green');
        return;
      }
    }

    const times = today.time.split('–');
    const opens = parseTime(times[0]);
    const closes = parseTime(times[1]);

    if (opens === null) {
      statusElement.textContent = 'See opening hours below';
      setStatusColour('red');
      return;
    }

    // Sunday has no fixed closing time.
    if (now.day === 0) {
      statusElement.textContent = now.minutes < opens
        ? 'Scheduled to open at ' + formatTime(opens)
        : 'Sunday hours · Open from ' +
          formatTime(opens) + ', closing time varies';

      setStatusColour('amber');
      return;
    }

    if (now.minutes < opens) {
      statusElement.textContent =
        'Scheduled to open at ' + formatTime(opens);
      setStatusColour('amber');

    } else if (closes !== null &&
               (closes < opens || now.minutes < closes)) {
      statusElement.textContent =
        'Scheduled open until ' + formatTime(closes);
      setStatusColour('green');

    } else {
      const tomorrow = getHours((now.day + 1) % 7);
      const nextOpen = tomorrow
        ? parseTime(tomorrow.time.split('–')[0])
        : null;

      statusElement.textContent = nextOpen !== null
        ? 'Next scheduled opening tomorrow at ' + formatTime(nextOpen)
        : 'See scheduled opening hours below';

      setStatusColour('red');
    }
  }

  updateOpeningStatus();
  setInterval(updateOpeningStatus, 60000);

  document.addEventListener('visibilitychange', function () {
    if (!document.hidden) updateOpeningStatus();
  });
})();
</script>
<!-- Mobile Navigation Menu -->
<script>
document.addEventListener('DOMContentLoaded', function () {

  const toggle = document.querySelector('.mobile-menu-toggle');
  const menu = document.getElementById('main-nav-links');

  if (!toggle || !menu) return;

  function closeMenu() {
    menu.classList.remove('menu-open');
    toggle.setAttribute('aria-expanded', 'false');
    toggle.setAttribute('aria-label', 'Open navigation menu');
    toggle.querySelector('span').textContent = '☰';
  }

  toggle.addEventListener('click', function () {
    const isOpen = menu.classList.toggle('menu-open');

    toggle.setAttribute('aria-expanded', String(isOpen));
    toggle.setAttribute(
      'aria-label',
      isOpen ? 'Close navigation menu' : 'Open navigation menu'
    );

    toggle.querySelector('span').textContent = isOpen ? '✕' : '☰';
  });

  menu.querySelectorAll('a').forEach(function (link) {
    link.addEventListener('click', closeMenu);
  });

  document.addEventListener('keydown', function (event) {
    if (event.key === 'Escape') closeMenu();
  });

  window.addEventListener('resize', function () {
    if (window.innerWidth > 720) closeMenu();
  });

});
</script>
<!-- Club News Category Navigation -->
<script>
(function () {
  const categories = document.getElementById('newsCategories');
  const categoryView = document.getElementById('newsCategoryView');
  const categoryTitle = document.getElementById('newsCategoryTitle');
  const backButton = document.getElementById('newsBackButton');
  const postsContainer = document.getElementById('blogPosts');
  const emptyMessage = document.getElementById('newsEmptyMessage');

  if (!categories || !categoryView || !categoryTitle ||
      !backButton || !postsContainer || !emptyMessage) return;

  const cards = Array.from(
    categories.querySelectorAll('.news-category-card')
  );

  const posts = Array.from(
    postsContainer.querySelectorAll('.post')
  );

  // Convert dates such as "21 October 2026" into sortable values.
  const months = {
    january: 0, february: 1, march: 2, april: 3,
    may: 4, june: 5, july: 6, august: 7,
    september: 8, october: 9, november: 10, december: 11
  };

  function dateValue(value) {
    const match = (value || '').trim().match(
      /^(\d{1,2})\s+([A-Za-z]+)\s+(\d{4})$/
    );

    if (!match) return 0;

    const month = months[match[2].toLowerCase()];
    if (month === undefined) return 0;

    return Date.UTC(
      Number(match[3]),
      month,
      Number(match[1])
    );
  }

  // Sort all articles newest first.
  posts.sort(function (a, b) {
    return dateValue(b.dataset.date) -
           dateValue(a.dataset.date);
  });

  posts.forEach(function (post) {
    postsContainer.appendChild(post);
  });

  // Display the number of articles in each category.
  cards.forEach(function (card) {
    const category = card.dataset.category;

    const count = posts.filter(function (post) {
      return post.dataset.category === category;
    }).length;

    const countElement = card.querySelector(
      '.news-category-count'
    );

    if (countElement) {
      countElement.textContent =
        count + (count === 1 ? ' article' : ' articles');
    }

    card.addEventListener('click', function () {
      openCategory(category);
    });
  });

  function openCategory(category) {
    let visibleCount = 0;

    posts.forEach(function (post) {
      const matches = post.dataset.category === category;

      post.hidden = !matches;

      if (matches) visibleCount++;
    });

    categoryTitle.textContent = category;

    emptyMessage.hidden = visibleCount > 0;

    categories.hidden = true;
    categoryView.hidden = false;

    backButton.focus();
  }

  backButton.addEventListener('click', function () {
    categoryView.hidden = true;
    categories.hidden = false;

    posts.forEach(function (post) {
      post.hidden = false;
    });

    categoryTitle.textContent = '';

    // Return keyboard focus to the category selection.
    const firstCard = cards[0];
    if (firstCard) firstCard.focus();
  });

})();
</script>
<!-- Club Standards & Feedback Navigation -->
<script>
(function () {
  const categories = document.getElementById('standardsCategories');
  const content = document.getElementById('standardsContent');
  const backButton = document.getElementById('standardsBackButton');

  if (!categories || !content || !backButton) return;

  const cards = Array.from(
    categories.querySelectorAll('.standards-category-card')
  );

  const panels = Array.from(
    content.querySelectorAll('.standards-panel')
  );

  let lastSelectedCard = null;

  cards.forEach(function (card) {
    card.addEventListener('click', function () {
      const selectedPanel = document.getElementById(
        'standards-' + card.dataset.panel
      );

      if (!selectedPanel) return;

      lastSelectedCard = card;

      panels.forEach(function (panel) {
        panel.hidden = panel !== selectedPanel;
      });

      categories.hidden = true;
      content.hidden = false;

      backButton.focus();
    });
  });

  backButton.addEventListener('click', function () {
    content.hidden = true;
    categories.hidden = false;

    panels.forEach(function (panel) {
      panel.hidden = true;
    });

    if (lastSelectedCard) {
      lastSelectedCard.focus();
    }
  });
})();
</script>

