<!-- Public Website Visitor Counter -->
<script>
(function () {
  const counter = document.getElementById('websiteViewCount');

  if (!counter) return;

  fetch('https://watlingtonssc.goatcounter.com/counter/TOTAL.json')
    .then(function (response) {
      if (!response.ok) {
        throw new Error('Unable to retrieve visitor count');
      }
      return response.json();
    })
    .then(function (data) {
      counter.textContent = data.count;
    })
    .catch(function (error) {
      console.error('Visitor counter error:', error);
      counter.textContent = '';
    });
})();
</script>

