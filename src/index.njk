<div class="lightbox-overlay" id="lightboxOverlay" onclick="closeLightbox(event)">
  <img id="lightboxImg" src="" alt="Enlarged photo">
</div>
<button class="lightbox-nav" id="lightboxPrev" onclick="event.stopPropagation(); galleryNav(-1)">&#8249;</button>
<button class="lightbox-nav" id="lightboxNext" onclick="event.stopPropagation(); galleryNav(1)">&#8250;</button>
<div class="lightbox-counter" id="lightboxCounter"></div>

<script>
  // ---------- Lightbox (single image + gallery sets) ----------
  var gallerySets = {{ gallery.sets | dump | safe }};
  var currentSetIndex = 0;
  var currentPhotoIndex = 0;
  var inGalleryMode = false;

  function openLightbox(src){
    inGalleryMode = false;
    document.getElementById('lightboxImg').src = src;
    document.getElementById('lightboxOverlay').classList.add('active');
    document.getElementById('lightboxPrev').classList.remove('active');
    document.getElementById('lightboxNext').classList.remove('active');
    document.getElementById('lightboxCounter').classList.remove('active');
  }

  function openGallerySet(setIndex, photoIndex){
    inGalleryMode = true;
    currentSetIndex = setIndex;
    currentPhotoIndex = photoIndex;
    showGalleryImage();
    document.getElementById('lightboxOverlay').classList.add('active');
    var multi = gallerySets[setIndex].photos.length > 1;
    document.getElementById('lightboxPrev').classList.toggle('active', multi);
    document.getElementById('lightboxNext').classList.toggle('active', multi);
    document.getElementById('lightboxCounter').classList.toggle('active', multi);
  }

  function showGalleryImage(){
    var photos = gallerySets[currentSetIndex].photos;
    document.getElementById('lightboxImg').src = photos[currentPhotoIndex];
    document.getElementById('lightboxCounter').textContent = (currentPhotoIndex + 1) + ' of ' + photos.length;
  }

  function galleryNav(dir){
    if (!inGalleryMode) return;
    var photos = gallerySets[currentSetIndex].photos;
    currentPhotoIndex = (currentPhotoIndex + dir + photos.length) % photos.length;
    showGalleryImage();
  }

  function closeLightbox(e){
    document.getElementById('lightboxOverlay').classList.remove('active');
    document.getElementById('lightboxPrev').classList.remove('active');
    document.getElementById('lightboxNext').classList.remove('active');
    document.getElementById('lightboxCounter').classList.remove('active');
  }

  // ---------- Host Your Event tabs + per-tab slideshow ----------
  var hostEventsData = {{ hostEvents | dump | safe }};
  var tabLabels = { babyShower: 'Baby Shower', genderReveal: 'Gender Reveal', wedding: 'Wedding Reception' };
  var slideState = {}; // per tab: { index, timer }

  function setupSlideshow(tabKey){
    var items = hostEventsData[tabKey] || [];
    var panel = document.getElementById('panel-' + tabKey);
    var slideshow = document.getElementById('memSlideshow-' + tabKey);
    var empty = panel.querySelector('.event-empty');

    if (items.length === 0) {
      slideshow.style.display = 'none';
      empty.style.display = 'block';
      return;
    }
    slideshow.style.display = '';
    empty.style.display = 'none';

    var dotsWrap = slideshow.querySelector('.mem-dots');
    dotsWrap.innerHTML = '';
    items.forEach(function(item, i){
      var d = document.createElement('button');
      d.className = 'mem-dot';
      d.setAttribute('aria-label', 'Go to photo ' + (i + 1));
      d.onclick = function(){ memGo(tabKey, i); };
      dotsWrap.appendChild(d);
    });

    slideState[tabKey] = { index: 0, timer: null };
    renderSlide(tabKey);
    resetSlideTimer(tabKey);

    slideshow.onmouseenter = function(){
      if (slideState[tabKey].timer) clearInterval(slideState[tabKey].timer);
    };
    slideshow.onmouseleave = function(){ resetSlideTimer(tabKey); };
  }

  function renderSlide(tabKey){
    var items = hostEventsData[tabKey];
    var state = slideState[tabKey];
    var slideshow = document.getElementById('memSlideshow-' + tabKey);
    var img = slideshow.querySelector('.mem-img');
    var cap = slideshow.querySelector('.mem-caption');
    img.src = items[state.index].src;
    img.alt = items[state.index].caption;
    cap.textContent = items[state.index].caption;
    var dots = slideshow.querySelectorAll('.mem-dot');
    dots.forEach(function(d, i){ d.classList.toggle('active', i === state.index); });
  }

  function resetSlideTimer(tabKey){
    var state = slideState[tabKey];
    if (state.timer) clearInterval(state.timer);
    var items = hostEventsData[tabKey];
    if (items.length < 2) return;
    state.timer = setInterval(function(){
      state.index = (state.index + 1) % items.length;
      renderSlide(tabKey);
    }, 5000);
  }

  window.memMove = function(delta){
    var activeTab = document.querySelector('.event-tab.active').dataset.tab;
    var state = slideState[activeTab];
    var items = hostEventsData[activeTab];
    state.index = (state.index + delta + items.length) % items.length;
    renderSlide(activeTab);
    resetSlideTimer(activeTab);
  };

  window.memGo = function(tabKey, i){
    slideState[tabKey].index = i;
    renderSlide(tabKey);
    resetSlideTimer(tabKey);
  };

  function eventTab(tabKey, btn){
    document.querySelectorAll('.event-tab').forEach(function(b){ b.classList.remove('active'); });
    document.querySelectorAll('.event-panel').forEach(function(p){ p.classList.remove('active'); });
    btn.classList.add('active');
    document.getElementById('panel-' + tabKey).classList.add('active');
  }

  document.addEventListener('DOMContentLoaded', function(){
    Object.keys(tabLabels).forEach(function(key){ setupSlideshow(key); });
    // Activate the first tab that actually has photos, else the first tab
    var firstWithPhotos = Object.keys(tabLabels).find(function(k){ return (hostEventsData[k] || []).length > 0; });
    var activeKey = firstWithPhotos || 'babyShower';
    var activeBtn = document.querySelector('.event-tab[data-tab="' + activeKey + '"]');
    eventTab(activeKey, activeBtn);
  });
</script>

<script>
// ---------- Upcoming events: UK time, chronological order and expiry ----------
(function () {
  const events = {{ whatsOn.thisMonth | dump | safe }};
  const featured = document.getElementById('featuredEvent');
  const more = document.getElementById('moreEvents');
  const empty = document.getElementById('noUpcomingEvents');
  if (!featured || !more || !empty) return;

  function ukNow() {
    const parts = new Intl.DateTimeFormat('en-GB', {
      timeZone: 'Europe/London', year: 'numeric', month: '2-digit',
      day: '2-digit', hour: '2-digit', minute: '2-digit', hourCycle: 'h23'
    }).formatToParts(new Date());
    const v = {};
    parts.forEach(function (p) { v[p.type] = p.value; });
    return { date: v.year + '-' + v.month + '-' + v.day,
      minute: Number(v.hour) * 60 + Number(v.minute) };
  }

  function minutes(value) {
    if (!/^([01]\d|2[0-3]):[0-5]\d$/.test(value || '')) return null;
    const bits = value.split(':');
    return Number(bits[0]) * 60 + Number(bits[1]);
  }

  function nextDay(date) {
    const d = new Date(date + 'T12:00:00Z');
    d.setUTCDate(d.getUTCDate() + 1);
    return d.toISOString().slice(0, 10);
  }

  function expiry(event) {
    const end = minutes(event.endTime);
    const start = minutes(event.startTime);
    if (end !== null) {
      // End times earlier than start times are treated as overnight events.
      return { date: start !== null && end < start ? nextDay(event.eventDate) : event.eventDate,
        minute: end };
    }
    // No advertised finish time: keep the event visible until 6am the next morning.
    return { date: nextDay(event.eventDate), minute: 360 };
  }

  function isUpcoming(event, now) {
    if (!/^\d{4}-\d{2}-\d{2}$/.test(event.eventDate || '')) return true;
    const until = expiry(event);
    return until.date > now.date || (until.date === now.date && until.minute > now.minute);
  }

  function formatDate(event) {
    if (!event.eventDate) return event.dateLabel || 'Date to be confirmed';
    const parts = event.eventDate.split('-').map(Number);
    const d = new Date(Date.UTC(parts[0], parts[1] - 1, parts[2], 12));
    return new Intl.DateTimeFormat('en-GB', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(d);
  }

  function formatClock(time) {
    const value = minutes(time);
    if (value === null) return '';
    const hour = Math.floor(value / 60);
    const minute = value % 60;
    return (hour % 12 || 12) + (minute ? ':' + String(minute).padStart(2, '0') : '') + (hour >= 12 ? 'pm' : 'am');
  }

  function timeLabel(event) {
    const start = formatClock(event.startTime);
    const end = formatClock(event.endTime);
    if (start && end) return start + '–' + end;
    if (start) return 'From ' + start;
    if (end) return 'Until ' + end;
    return 'Time to be confirmed';
  }

  function element(tag, className, content) {
    const el = document.createElement(tag);
    if (className) el.className = className;
    if (content !== undefined) el.textContent = content;
    return el;
  }

  function eventCard(event, large) {
    const card = element('article', large ? 'featured-event' : 'event-card');
    const imageButton = element('button', 'event-poster-button');
    imageButton.type = 'button';
    imageButton.setAttribute('aria-label', 'View full poster for ' + event.title);
    const img = element('img', 'event-poster');
    img.src = event.badge;
    img.alt = event.title + ' event poster';
    img.loading = 'lazy';
    imageButton.appendChild(img);
    imageButton.addEventListener('click', function () { openLightbox(event.badge); });
    card.appendChild(imageButton);

    const info = element('div', 'event-card-info');
    if (large) info.appendChild(element('span', 'event-feature-label', 'NEXT UP AT THE CLUB'));
    info.appendChild(element('p', 'event-card-date', formatDate(event)));
    info.appendChild(element('h3', 'event-card-title', event.title));
    info.appendChild(element('p', 'event-card-time', timeLabel(event)));
    info.appendChild(element('p', 'event-card-description', event.description || ''));
    const view = element('button', 'event-view-poster', 'View full poster');
    view.type = 'button';
    view.addEventListener('click', function () { openLightbox(event.badge); });
    info.appendChild(view);
    card.appendChild(info);
    return card;
  }

  function renderUpcoming() {
    const now = ukNow();
    const upcoming = events.filter(function (e) { return isUpcoming(e, now); });
    upcoming.sort(function (a, b) {
      // Unscheduled events remain visible at the end until a date is entered in CMS.
      return (a.eventDate || '9999-12-31').localeCompare(b.eventDate || '9999-12-31') ||
        (a.startTime || '00:00').localeCompare(b.startTime || '00:00');
    });
    featured.replaceChildren();
    more.replaceChildren();
    empty.hidden = upcoming.length > 0;
    if (!upcoming.length) return;
    featured.appendChild(eventCard(upcoming[0], true));
    upcoming.slice(1).forEach(function (event) { more.appendChild(eventCard(event, false)); });
  }

  renderUpcoming();
  setInterval(renderUpcoming, 60000);
  document.addEventListener('visibilitychange', function () {
    if (!document.hidden) renderUpcoming();
  });
})();
</script>

